# Copy to `.env.production` and fill in real values. Never commit the real file.
# docker compose reads this file (see docker-compose.yml).

# Signs login cookies. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Admin account created by `docker compose exec app npx prisma db seed`
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
